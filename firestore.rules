rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 유저 (프로필, 닉네임 등) 설정
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['crackers'])
      );
      
      // 유저별 작성/스크랩 권한
      match /likes/{postId} {
        allow read: if true;
        allow write: if true;
      }
      match /scraps/{postId} {
        allow read: if true;
        allow write: if true;
      }

      // 방금 새로 추가된 댓글 좋아요 권한
      match /comment_likes/{commentId} {
        allow read, write: if true;
      }
    }

    // 디바이스 토큰 관리
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (
          resource == null
          || resource.data.date != request.resource.data.date
          || resource.data.userId == request.auth.uid
        );
    }

    // 게시글 및 댓글 권한
    match /posts/{postId} {
      allow read: if true; 
      allow write: if true; 
      
      match /comments/{commentId} {
        allow read: if true;
        allow write: if true;
      }

      match /voters/{voterId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 전역 닉네임 유일성 체크 (기존 추가본)
    match /nicknames/{nickname} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
