{
  "name": "restart_app",
  "version": "1.7.3",
  "summary": "A Flutter plugin to restart the app using native APIs.",
  "description": "A Flutter plugin that helps you to restart the whole Flutter app with a single function call by using native APIs.",
  "homepage": "https://github.com/gabrimatic/restart_app",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "Soroush Yousefpour": "https://gabrimatic.info"
  },
  "source": {
    "path": "."
  },
  "source_files": "restart_app/Sources/restart_app/**/*",
  "dependencies": {
    "Flutter": []
  },
  "platforms": {
    "ios": "11.0"
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "swift_versions": "5.0",
  "swift_version": "5.0"
}
